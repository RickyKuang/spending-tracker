# DATABASE_URL: Postgres connection string used by cmd/api (pgxpool) and goose migrations.
DATABASE_URL=postgres://spender:changeme@localhost:5432/spender?sslmode=disable

# PLAID_CLIENT_ID: Your Plaid Client ID, from the Plaid dashboard.
PLAID_CLIENT_ID=your_plaid_client_id

# PLAID_SECRET: Your Plaid Secret for the environment set below (never commit the real value).
PLAID_SECRET=your_plaid_secret

# PLAID_ENV: Which Plaid environment to talk to. One of: sandbox | development | production.
PLAID_ENV=sandbox

# APP_ENCRYPTION_KEY: 32 random bytes, base64-encoded, used for AES-256-GCM sealing of Plaid access tokens. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=changeme_base64_encoded_32_bytes

# HTTP_ADDR: Address the API server listens on.
HTTP_ADDR=:8080

# LOG_LEVEL: slog log level. One of: debug | info | warn | error.
LOG_LEVEL=info
